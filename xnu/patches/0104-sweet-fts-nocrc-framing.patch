+/* One read attempt in the selected framing.  With CRC (0xA0) the chip appends
+ * a CRC-16/KERMIT; without it (0x80) the payload ends the message.  The
+ * vendor driver always asks for CRC, but some FT8006S firmware ignores
+ * DATA_CRC_EN and answers with the payload and no CRC bytes at all - the
+ * status byte still matches, so only the trailing CRC check fails.  The
+ * probe therefore tries CRC first and falls back to 0x80. */
 static int
-touch_fog_fts_read(uint8_t addr, uint8_t *buf, unsigned n)

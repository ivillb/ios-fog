 {
 	uint8_t tx[96], rx[96];
-	unsigned len = 4u + FTS_DUMMY + n + 2u;
-	int err = EIO;
+	unsigned len = 4u + FTS_DUMMY + n + (crc ? 2u : 0u);
+	uint16_t want, have;
+	int err;
 
 	if (n == 0 || len > sizeof(tx)) {
 		return EINVAL;
 	}
 	memset(tx, 0, sizeof(tx));

+/* ---------------------------------------------------------------------
+ * FocalTech FT8006S ("fts_ts") over the same SE0 GENI SPI.
+ *
+ * fog/rain ship two digitizer variants on the identical wiring (reset GPIO
+ * 86, IRQ GPIO 80, 9.6 MHz, 720x1650) and the same DT node, whose
+ * compatible list is "novatek,NVT-ts-spi", "focaltech,fts": the Novatek
+ * driver probes first and gives up with "Unknow Touch" on the FocalTech
+ * parts, then the vendor fts_ts driver binds.  Only the protocol differs,
+ * so the SE0 transport above is reused verbatim and the chip is detected
+ * by its ID register.
+ *
+ * Framing, from drivers/input/touchscreen/ft8006s_spi/focaltech_spi.c:
+ *   tx[0] = register, tx[1] = command, tx[2..3] = big-endian length,
+ *   three dummy bytes, then the payload.  Reads use command 0xA0
+ *   (0x80 | CRC) and append a CRC-16/KERMIT of the payload, little endian;
+ *   writes use 0x00 and carry no CRC.  One full-duplex transfer per
+ *   command: CS stays asserted for the whole message.  rx[3] & 0xA0 must
+ *   be clear, which is the chip's own status byte.
+ * ------------------------------------------------------------------- */
+#define FTS_REG_TOUCH   0x01u   /* point block: [count][10 x 6 bytes] */
+#define FTS_REG_CHIP_ID 0xa3u
+#define FTS_REG_FW_VER  0xa6u
+#define FTS_REG_POWER   0xa5u
+#define FTS_POWER_ON    0x00u
+#define FTS_CMD_READ    0xa0u   /* 0x80 | DATA_CRC_EN */
+#define FTS_CMD_WRITE   0x00u
+#define FTS_DUMMY       3u      /* vendor SPI_DUMMY_BYTE */
+#define FTS_OFF         7u      /* 4 header bytes + 3 dummy */
+#define FTS_ONE_TCH     6u
+#define FTS_POINTS      10u
+#define FTS_DATA_LEN    (FTS_POINTS * FTS_ONE_TCH + 3u)   /* 63 */
+#define FTS_MAX_ID      0x0au
+#define FTS_STATUS_MASK 0xa0u
+#define FTS_RETRIES     3u      /* vendor SPI_RETRY_NUMBER */
+
+static int (*fog_report_fn)(void);
+
+static uint16_t
+touch_fog_fts_crc(const uint8_t *p, unsigned n)
+{
+	uint16_t crc = 0xffffu;
+
+	for (unsigned i = 0; i < n; ++i) {
+		crc ^= p[i];
+		for (unsigned j = 0; j < 8; ++j) {
+			crc = (crc & 1u) ? (uint16_t)((crc >> 1) ^ 0x8408u) :
+			    (uint16_t)(crc >> 1);
+		}
+	}
+	return crc;
+}
+
+static int
+touch_fog_fts_read(uint8_t addr, uint8_t *buf, unsigned n)
+{
+	uint8_t tx[96], rx[96];
+	unsigned len = 4u + FTS_DUMMY + n + 2u;
+	int err = EIO;
+
+	if (n == 0 || len > sizeof(tx)) {
+		return EINVAL;
+	}
+	memset(tx, 0, sizeof(tx));
+	tx[0] = addr;
+	tx[1] = FTS_CMD_READ;
+	tx[2] = (uint8_t)(n >> 8);
+	tx[3] = (uint8_t)n;
+	/* The vendor driver retries SPI_RETRY_NUMBER times: a frame can be
+	 * dropped right after reset and the status/CRC check catches it. */
+	for (unsigned i = 0; i < FTS_RETRIES; ++i) {
+		uint16_t want, have;
+
+		memset(rx, 0, sizeof(rx));
+		err = touch_spi_run(SPI_TX_RX, 0, tx, len, rx, len);
+		if (err) {
+			touch_wait(1);
+			continue;
+		}
+		if (rx[3] & FTS_STATUS_MASK) {
+			err = EIO;
+			touch_wait(1);
+			continue;
+		}
+		memcpy(buf, rx + FTS_OFF, n);
+		want = (uint16_t)rx[FTS_OFF + n] |
+		    ((uint16_t)rx[FTS_OFF + n + 1u] << 8);
+		have = touch_fog_fts_crc(buf, n);
+		if (want == have) {
+			return 0;
+		}
+		err = EIO;
+		touch_wait(1);
+	}
+	return err;
+}
+
+static int
+touch_fog_fts_write(uint8_t addr, const uint8_t *data, unsigned n)
+{
+	uint8_t tx[96], rx[96];
+	unsigned len = 4u + FTS_DUMMY + n;
+	int err = EIO;
+
+	if (len > sizeof(tx)) {
+		return EINVAL;
+	}
+	memset(tx, 0, sizeof(tx));
+	tx[0] = addr;
+	tx[1] = FTS_CMD_WRITE;
+	tx[2] = (uint8_t)(n >> 8);
+	tx[3] = (uint8_t)n;
+	if (n) {
+		memcpy(tx + FTS_OFF, data, n);
+	}
+	for (unsigned i = 0; i < FTS_RETRIES; ++i) {
+		memset(rx, 0, sizeof(rx));
+		err = touch_spi_run(SPI_TX_RX, 0, tx, len, rx, len);
+		if (!err && !(rx[3] & FTS_STATUS_MASK)) {
+			return 0;
+		}
+		err = err ? err : EIO;
+		touch_wait(1);
+	}
+	return err;
+}
+
+/* The FTS framing validates itself twice: the chip's status byte must have
+ * bits 7 and 5 clear and the payload must match its CRC-16.  No Novatek part
+ * answers that, so a successful read of 0xA3 is the detection.  Our panel
+ * reports 0x86 (the vendor driver prints "IC ID:0x8642", i.e. 0x86 at 0xA3
+ * and 0x42 at 0x9F); 0x54/0x64 appear on other FT8006S builds and 0x1e/0x22
+ * are the two vendor IC serials, so the value is logged but not enforced. */
+static bool
+touch_fog_fts_probe(void)
+{
+	uint8_t id = 0, fw = 0, on = FTS_POWER_ON;
+	int e1, e2, e3;
+
+	e1 = touch_fog_fts_read(FTS_REG_CHIP_ID, &id, 1);
+	if (e1) {
+		printf("SWEET TOUCH: fog fts no answer err=%d\n", e1);
+		return false;
+	}
+	e2 = touch_fog_fts_read(FTS_REG_FW_VER, &fw, 1);
+	printf("SWEET TOUCH: fog fts chipid=%02x fw=%02x err=%d\n", id, fw, e2);
+	if (id == 0x00u || id == 0xffu) {
+		printf("SWEET TOUCH: fog fts implausible chipid %02x\n", id);
+		return false;
+	}
+	e3 = touch_fog_fts_write(FTS_REG_POWER, &on, 1);
+	printf("SWEET TOUCH: fog fts active err=%d\n", e3);
+	return true;
+}
+
+/* Point block: count in buf[1] (register 0x02), then ten 6-byte records.
+ * x = ((p[2] & 0x0f) << 8) | p[3], y = ((p[4] & 0x0f) << 8) | p[5],
+ * event = p[2] >> 6 (0 down, 1 up, 2 contact), id = p[4] >> 4. */
+static int
+touch_fog_fts_report(void)
+{
+	uint8_t buf[FTS_DATA_LEN];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	unsigned points, n = 0;
+	int err;
+
+	err = touch_fog_fts_read(FTS_REG_TOUCH, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+	/* 0xEF in the count byte and the first record means the chip rebooted
+	 * (vendor fts_read_touchdata treats it as a firmware reset). */
+	if (buf[1] == 0xefu && buf[2] == 0xefu && buf[3] == 0xefu) {
+		return EIO;
+	}
+	points = buf[1] & 0x0fu;
+	if (points > FTS_POINTS) {
+		return EIO;
+	}
+	if (!st.s_frames || points) {
+		memcpy(st.s_raw, buf, sizeof(st.s_raw));
+	}
+	st.s_frames++;
+	for (unsigned i = 0; i < FTS_POINTS; ++i) {
+		unsigned base = FTS_ONE_TCH * i;
+		unsigned id = buf[4u + base] >> 4;
+		unsigned ev = buf[2u + base] >> 6;
+		unsigned px, py;
+
+		if (id >= FTS_MAX_ID) {
+			break;
+		}
+		if (ev == 1u) {   /* lifted */
+			continue;
+		}
+		px = ((unsigned)(buf[2u + base] & 0x0fu) << 8) |
+		    buf[3u + base];
+		py = ((unsigned)(buf[4u + base] & 0x0fu) << 8) |
+		    buf[5u + base];
+		if (px >= FOG_PANEL_W) {
+			px = FOG_PANEL_W - 1u;
+		}
+		if (py >= FOG_PANEL_H) {
+			py = FOG_PANEL_H - 1u;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+		n++;
+	}
+	if (n > st.s_maxn) {
+		st.s_maxn = n;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
